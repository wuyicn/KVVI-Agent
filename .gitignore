# ══════════════════════════════════════════════════════════════
#  KVVI-Agent .gitignore
# ══════════════════════════════════════════════════════════════

# ── 依赖目录（任何位置）────────────────────────────────────────
# 可由 `pnpm install` / `npm install` 完整复现，不进仓库。
node_modules/

# ── DSH 上游源码工作副本 ───────────────────────────────────────
# vendor/dsh 是 @deepseek-ai/dsh 的未修改克隆（上游 MIT，默认分支 master）。
# 体积 151MB / 12,087 文件，安装依赖后达 2.1GB。
# 可由 `git clone --depth 1 https://github.com/deepseek-ai/deepseek-harness.git` 复现。
#
# 说明：正式 fork 改造时，应将其拆为独立仓库，或改为 git submodule 正式引用。
vendor/dsh/

# ── 交付包产物 ─────────────────────────────────────────────────
# 自包含 tar（约 200MB）由 `python3 工具/fork.py --bundle` 生成。
# 它**可重建**：上游源码 + `forks/dsh/变更/` 的 35 个文件，且重建结果与指纹逐字节可比对。
# 故不入库；要交付时现打一份即可。
交付/包/

# ── KVVI 自有构建产物 ──────────────────────────────────────────
# 注意：以下规则刻意【不加 vendor/ 前缀以外的全局 lib/、dist/】，
# 因为 vendor/dsh-node-flow 的 lib/ 与 dist/ 是已构建产物，
# 而该包未发布到 npm，产物丢失后无法复现，必须纳入版本管理。
/build/
/coverage/
*.tsbuildinfo

# ── 本地环境与配置 ─────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── 日志与临时文件 ─────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── Python（MetaSchema 双引擎验证器）───────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv*/

# ── 操作系统 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 编辑器 ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── 探针残留（内容已并入 samples/事项登记/00-需求.md）──
samples/.kvvi-probe-task.txt

# ── KVVI 自己的运行时目录 ──────────────────────────────────────
# 从源码启动 KVVI 时使用的独立 DSH_HOME（scripts/kvvi-web.sh 创建）。
# 与用户的 ~/.dsh 隔离，含会话、设置与 profile，不进版本管理。
.kvvi-home/

# 契约资产的构建产物（资产本身入库，依赖不入库）
tools/meta-schema/python/.venv/
tools/meta-schema/node/node_modules/
**/__pycache__/
*.pyc

# Docker 本地开发令牌（含进程间调用凭据）
.kvvi-docker.env
