{
  "name": "dsh-node-flow",
  "version": "0.2.0",
  "description": "DSH-native workflow automation platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxi233/dsh-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/luxi233/dsh-workflow/issues"
  },
  "homepage": "https://github.com/luxi233/dsh-workflow#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "import": "./lib/runtime.js"
    },
    "./runtime-automation": {
      "types": "./lib/runtime-automation.d.ts",
      "import": "./lib/runtime-automation.js"
    },
    "./runtime-integrations": {
      "types": "./lib/runtime-integrations.d.ts",
      "import": "./lib/runtime-integrations.js"
    },
    "./runtime-resilience": {
      "types": "./lib/runtime-resilience.d.ts",
      "import": "./lib/runtime-resilience.js"
    },
    "./connector-sdk": {
      "types": "./lib/connectorRegistry.d.ts",
      "import": "./lib/connectorRegistry.js"
    },
    "./ui": {
      "types": "./lib/ui.d.ts",
      "import": "./lib/ui.js"
    },
    "./client": {
      "types": "./lib/ui.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-server-entry.mjs && node scripts/build-client.mjs && vite build",
    "build:client": "node scripts/build-client.mjs",
    "dev": "vite",
    "test": "npm run build:test && node --test .test-dist/**/*.test.js",
    "test:e2e": "node scripts/test-workflow-revisions.mjs && node scripts/test-workflow-versions.mjs",
    "test:runtime": "node scripts/test-runtime-resilience.mjs",
    "test:runtime:data-store": "npm run build && node scripts/test-runtime-data-store.mjs",
    "test:live": "node scripts/test-live-integrations.mjs",
    "test:live:ui": "node scripts/test-live-resilience-ui.mjs",
    "test:live:mapper": "node scripts/test-live-mapper.mjs",
    "test:live:resilience": "node scripts/test-live-resilience.mjs",
    "test:live:error-routes": "node scripts/test-live-error-routes.mjs",
    "test:live:error-routes:ui": "node scripts/test-live-error-routes-ui.mjs",
    "test:live:debugger": "node scripts/test-live-debugger.mjs",
    "test:live:debugger:ui": "node scripts/test-live-debugger-ui.mjs",
    "test:live:inputs": "node scripts/test-live-workflow-inputs.mjs",
    "test:live:inputs:ui": "node scripts/test-live-workflow-inputs-ui.mjs",
    "test:live:versions": "node scripts/test-live-versions.mjs",
    "test:live:versions:ui": "node scripts/test-live-versions-ui.mjs",
    "test:live:oauth2": "node scripts/test-live-oauth2.mjs",
    "test:live:oauth2:ui": "node scripts/test-live-oauth2-ui.mjs",
    "test:live:subworkflows": "node scripts/test-live-subworkflows.mjs",
    "test:live:connectors:ui": "node scripts/test-live-connectors-ui.mjs",
    "test:live:webhooks": "node scripts/test-live-webhooks.mjs",
    "test:live:webhooks:ui": "node scripts/test-live-webhooks-ui.mjs",
    "test:live:waitpoints": "node scripts/test-live-waitpoints.mjs",
    "test:live:waitpoints:ui": "node scripts/test-live-waitpoints-ui.mjs",
    "test:live:variables": "node scripts/test-live-project-variables.mjs",
    "test:live:folders": "node scripts/test-live-workflow-folders.mjs",
    "test:live:folders:ui": "node scripts/test-live-workflow-folders-ui.mjs",
    "test:live:audit:ui": "node scripts/test-live-audit-log-ui.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workflow",
    "canvas",
    "react-flow",
    "xyflow",
    "agent",
    "visual",
    "orchestration"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "lucide-react": "^0.468.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.55.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
