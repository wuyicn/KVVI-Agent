#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""`kvvi-admin`：发行版唯一的运维入口。

## 为什么只有一个入口

客户机器上没有我们的开发环境。运维动作如果分散成若干脚本，客户会按自己的顺序拼，
而顺序恰恰是这些动作里最容易出错的部分（先建库还是先迁移、备份在升级之前还是之后）。
所以全部收在一个命令下，每个子命令自己知道该先做什么。

## `--plan` 与 `--apply`

每一个会改状态的子命令都分两步：

    kvvi-admin install --plan      # 只打印将要做什么，**不写任何东西**
    kvvi-admin install --apply     # 执行；非交互环境下另需 --yes

「先看计划、再执行」不是仪式：§9.2 要求安装前展示将创建的目录、数据库、角色与端口，
而客户要能在**没有任何东西被改动**的前提下读它。

## 退出码

| 码 | 含义 |
|---|---|
| 0 | 成功 |
| 1 | 用法错误（参数不对） |
| 2 | 前置检查未通过（环境不合适，**什么都没改**） |
| 3 | 执行失败（已经动过东西，看输出里的恢复指引） |

⚠️ 「用法错误」与「前置检查未通过」**必须是两个码**。argparse 默认对无法识别的子命令
退出 2 —— 与前置检查失败撞在一起，于是安装脚本无法区分「我参数写错了」
和「这台机器不合适」，只能把两句完全不同的话显示成同一句。所以下面把
argparse 的用法错误改到 1。

用法：

    kvvi-admin preflight [--json] [--config <path>]
    kvvi-admin install --plan|--apply [--yes]
    kvvi-admin start|stop|status
    kvvi-admin backup|restore|upgrade|rollback|uninstall

本文件只实现 `preflight`；其余子命令在后续任务里逐个接上，未接上的会**明确报未实现**
并给出退出码 1 —— 一个静默什么都不做的运维命令比没有更坏。
"""

import argparse
import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE.parent))

from distribution.lib.preflight import preflight  # noqa: E402

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_PREFLIGHT_FAILED = 2
EXIT_APPLY_FAILED = 3

DEFAULT_HOME = '~/Library/Application Support/KVVI-Agent'

#: 后续任务接上的子命令。**列出来**是为了让「还没做」与「打错字」区分开：
#: 前者说「尚未实现」，后者说「没有这个子命令」。混成一句话，
#: 客户会以为是自己的命令写错了。
PLANNED = ('install', 'start', 'stop', 'status', 'backup', 'restore',
           'upgrade', 'rollback', 'uninstall')


def load_config(path):
    """
    读安装配置；缺省时用一份最小默认值（端口与主目录）。
    @param path 配置文件路径，或 `None`
    @returns 配置字典
    """
    config = {'home': os.path.expanduser(DEFAULT_HOME), 'pg_port': 54329,
              'platform_port': 7400, 'min_disk_gib': 10.0, 'min_memory_gib': 4.0}
    if path is not None:
        with open(path, encoding='utf-8') as handle:
            config.update(json.load(handle))
    config['home'] = os.path.expanduser(config['home'])
    return config


def cmd_preflight(args):
    """
    `preflight`：只读的环境检查。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    report = preflight(config, HERE)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        print('KVVI-Agent macOS 试点发行版 · 环境前置检查')
        print()
        hardware = report['hardware']
        print(f"  系统      macOS {hardware['macosVersion']}（{hardware['architecture']}）")
        print(f"  内存/磁盘 {hardware['memoryGiB']} GiB / 可用 {hardware['freeDiskGiB']} GiB")
        postgres = report['postgres']
        print(f"  PostgreSQL 需要 {report['requiredPostgresMajor']}（{postgres['formula']}），"
              f"当前 {postgres['major'] if postgres['major'] else '未安装'}")
        print(f"  端口      平台 {report['ports']['platform']} / 数据库 {report['ports']['postgres']}")
        print()
        if report['ok']:
            print('✓ 环境检查通过。可以执行：kvvi-admin install --plan')
        else:
            print(f"✗ 环境检查未通过（{len(report['errors'])} 项）。**未改动任何文件。**")
            print()
            for index, error in enumerate(report['errors'], start=1):
                print(f'  {index}. {error["code"]}')
                print(f'     {error["guidance"]}')
            print()
            print('  处理完以上各项后重新运行：kvvi-admin preflight')
    return EXIT_OK if report['ok'] else EXIT_PREFLIGHT_FAILED


class _Parser(argparse.ArgumentParser):
    """用法错误退出 **1**，把 2 留给「前置检查未通过」。"""

    def error(self, message):
        """
        打印用法与原因后退出。
        @param message argparse 给出的原因
        """
        self.print_usage(sys.stderr)
        print(f'{self.prog}: 用法错误：{message}', file=sys.stderr)
        raise SystemExit(EXIT_USAGE)


def main(argv=None):
    """
    解析参数并分派。
    @param argv 命令行参数；缺省取 `sys.argv[1:]`
    @returns 退出码
    """
    parser = _Parser(prog='kvvi-admin', description='KVVI-Agent 运维入口')
    sub = parser.add_subparsers(dest='command')

    check = sub.add_parser('preflight', help='只读的环境检查')
    check.add_argument('--json', action='store_true', help='以 JSON 输出（供脚本与 Agent 消费）')
    check.add_argument('--config', default=None, help='安装配置文件的路径')

    for name in PLANNED:
        planned = sub.add_parser(name, help='（尚未实现）')
        planned.add_argument('--plan', action='store_true')
        planned.add_argument('--apply', action='store_true')
        planned.add_argument('--yes', action='store_true')
        planned.add_argument('--config', default=None)

    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return EXIT_USAGE
    if args.command == 'preflight':
        return cmd_preflight(args)
    if args.command in PLANNED:
        print(f'✗ `{args.command}` 尚未实现（阶段十一后续任务接上）。')
        print('  当前可用的子命令：preflight')
        return EXIT_USAGE
    parser.print_help()
    return EXIT_USAGE


if __name__ == '__main__':
    sys.exit(main())
