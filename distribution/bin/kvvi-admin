#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""`kvvi-admin`：发行版唯一的运维入口。

## 为什么只有一个入口

客户机器上没有我们的开发环境。运维动作如果分散成若干脚本，客户会按自己的顺序拼，
而顺序恰恰是这些动作里最容易出错的部分（先建库还是先迁移、备份在升级之前还是之后）。
所以全部收在一个命令下，每个子命令自己知道该先做什么。

## `--plan` 与 `--apply`

每一个会改状态的子命令都分两步：

    kvvi-admin install --plan      # 只打印将要做什么，**不写任何东西**
    kvvi-admin install --apply     # 执行；非交互环境下另需 --yes

「先看计划、再执行」不是仪式：§9.2 要求安装前展示将创建的目录、数据库、角色与端口，
而客户要能在**没有任何东西被改动**的前提下读它。

## 退出码

| 码 | 含义 |
|---|---|
| 0 | 成功 |
| 1 | 用法错误（参数不对） |
| 2 | 前置检查未通过（环境不合适，**什么都没改**） |
| 3 | 执行失败（已经动过东西，看输出里的恢复指引） |

⚠️ 「用法错误」与「前置检查未通过」**必须是两个码**。argparse 默认对无法识别的子命令
退出 2 —— 与前置检查失败撞在一起，于是安装脚本无法区分「我参数写错了」
和「这台机器不合适」，只能把两句完全不同的话显示成同一句。所以下面把
argparse 的用法错误改到 1。

用法：

    kvvi-admin preflight [--json] [--config <path>]
    kvvi-admin install --plan|--apply [--yes]
    kvvi-admin start --plan|--apply [--yes]
    kvvi-admin stop  --plan|--apply [--yes]
    kvvi-admin status [--json]
    kvvi-admin launchd            # 打印 plist，不自安装
    kvvi-admin backup|restore|upgrade|rollback|uninstall

备份/恢复/升级/回滚/卸载在后续任务接上，未接上的会**明确报未实现**并给出退出码 1
—— 一个静默什么都不做的运维命令比没有更坏。
"""

import argparse
import json
import os
import sys
from pathlib import Path

_DISTRIBUTION = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_DISTRIBUTION.parent))

from distribution.lib.preflight import preflight  # noqa: E402
from distribution.lib.install import (  # noqa: E402
    DEFAULT_HOME, install_plan, release_root_path,
)

#: 发行版根目录。**从 `install.py` 取，不在这里另算一遍** —— 见那里的说明。
HERE = release_root_path()
from distribution.lib.supervisor import (  # noqa: E402
    DEGRADATIONS, launchd_plist, readiness_report, start_plan, status_report, stop_plan,
)

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_PREFLIGHT_FAILED = 2
EXIT_APPLY_FAILED = 3

DEFAULT_HOME = '~/Library/Application Support/KVVI-Agent'

#: 已实现的子命令。
IMPLEMENTED = ('preflight', 'install', 'start', 'stop', 'status')

#: 后续任务接上的子命令。**列出来**是为了让「还没做」与「打错字」区分开：
#: 前者说「尚未实现」，后者说「没有这个子命令」。混成一句话，
#: 客户会以为是自己的命令写错了。
PLANNED = ('backup', 'restore', 'upgrade', 'rollback', 'uninstall')


def load_config(path):
    """
    读安装配置；缺省时用一份最小默认值（端口与主目录）。
    @param path 配置文件路径，或 `None`
    @returns 配置字典
    """
    config = {'home': os.path.expanduser(DEFAULT_HOME), 'pg_port': 54329,
              'platform_port': 7400, 'min_disk_gib': 10.0, 'min_memory_gib': 4.0}
    if path is not None:
        with open(path, encoding='utf-8') as handle:
            config.update(json.load(handle))
    config['home'] = os.path.expanduser(config['home'])
    return config


def cmd_preflight(args):
    """
    `preflight`：只读的环境检查。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    report = preflight(config, HERE)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        print('KVVI-Agent macOS 试点发行版 · 环境前置检查')
        print()
        hardware = report['hardware']
        print(f"  系统      macOS {hardware['macosVersion']}（{hardware['architecture']}）")
        print(f"  内存/磁盘 {hardware['memoryGiB']} GiB / 可用 {hardware['freeDiskGiB']} GiB")
        postgres = report['postgres']
        print(f"  PostgreSQL 需要 {report['requiredPostgresMajor']}（{postgres['formula']}），"
              f"当前 {postgres['major'] if postgres['major'] else '未安装'}")
        print(f"  端口      平台 {report['ports']['platform']} / 数据库 {report['ports']['postgres']}")
        print()
        if report['ok']:
            print('✓ 环境检查通过。可以执行：kvvi-admin install --plan')
        else:
            print(f"✗ 环境检查未通过（{len(report['errors'])} 项）。**未改动任何文件。**")
            print()
            for index, error in enumerate(report['errors'], start=1):
                print(f'  {index}. {error["code"]}')
                print(f'     {error["guidance"]}')
            print()
            print('  处理完以上各项后重新运行：kvvi-admin preflight')
    return EXIT_OK if report['ok'] else EXIT_PREFLIGHT_FAILED


class _Parser(argparse.ArgumentParser):
    """用法错误退出 **1**，把 2 留给「前置检查未通过」。"""

    def error(self, message):
        """
        打印用法与原因后退出。
        @param message argparse 给出的原因
        """
        self.print_usage(sys.stderr)
        print(f'{self.prog}: 用法错误：{message}', file=sys.stderr)
        raise SystemExit(EXIT_USAGE)


def _apply_or_plan(args, build_callable, label):
    """
    执行「计划 / 执行」两步里的一个。
    @param args 已解析的参数
    @param build_callable 造计划的函数
    @param label 子命令名（输出用）
    @returns 退出码
    """
    if not args.plan and not args.apply:
        print(f'✗ `{label}` 需要指明 --plan 或 --apply。', file=sys.stderr)
        print(f'  {label} --plan   只打印将要做什么，不改动任何东西', file=sys.stderr)
        print(f'  {label} --apply  执行', file=sys.stderr)
        return EXIT_USAGE
    plan = build_callable()
    if args.plan:
        # `--plan` 只打印：**不创建目录、不写配置、不起进程**。
        print(plan.describe())
        return EXIT_OK
    if not args.yes and not sys.stdin.isatty():
        # 非交互环境要显式 `--yes`：一个在管道里被默默执行的安装，
        # 出问题时没人知道它跑过。
        print('✗ 非交互环境下需要 --yes 才执行。', file=sys.stderr)
        return EXIT_USAGE
    result = plan.apply()
    if result['ok']:
        for line in result.get('steps', []):
            print(f'  ✓ {line}')
        print(f'✓ {label} 完成')
        if result.get('bootstrapTokenPath'):
            # **把下一步说出来**：装完之后客户面对的是一个要他填令牌的界面，
            # 而令牌在哪只有安装输出知道。不说，他只能去翻目录。
            print()
            print(f'  首次初始化令牌：{result["bootstrapTokenPath"]}')
            print('  下一步：kvvi-admin start --apply --yes，然后打开界面用该令牌建企业与所有者。')
        return EXIT_OK
    for error in result['errors']:
        print(f'  ✗ {error}', file=sys.stderr)
    print(f'✗ {label} 失败。已完成的步骤列在上面；重跑是幂等的。', file=sys.stderr)
    return EXIT_APPLY_FAILED


def cmd_install(args):
    """
    `install`：首次安装。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    return _apply_or_plan(args, lambda: install_plan(
        home=config['home'], pg_port=config['pg_port'],
        platform_port=config['platform_port']), 'install')


def cmd_start(args):
    """
    `start`：起平台与运行时（平台在前）。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    def build():
        readiness = readiness_report(home=config['home'],
                                     platform_port=config['platform_port'])
        if not readiness['ok']:
            for issue in readiness['issues']:
                print(f"  ✗ {issue['code']}：{issue['guidance']}", file=sys.stderr)
            raise SystemExit(EXIT_PREFLIGHT_FAILED)
        return start_plan(home=config['home'], release_root=HERE,
                          platform_port=config['platform_port'])
    try:
        return _apply_or_plan(args, build, 'start')
    except SystemExit as stop:
        return int(stop.code)


def cmd_stop(args):
    """
    `stop`：逆序停进程。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    return _apply_or_plan(args, lambda: stop_plan(home=config['home'], release_root=HERE),
                          'stop')


def cmd_status(args):
    """
    `status`：如实报告，**包括两个进程各自的运行用户**。
    @param args 已解析的参数
    @returns 退出码
    """
    config = load_config(args.config)
    report = status_report(home=config['home'], release_root=HERE)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
        return EXIT_OK
    print('KVVI-Agent 状态')
    print()
    for name, info in report['processes'].items():
        state = f"运行中 pid {info['pid']}" if info['running'] else '未运行'
        print(f"  {name:9s} {state:16s} 用户 {info['userName']}({info['user']})")
    print()
    print('已知降级（本版不满足，取证文档引用本报告）：')
    for degradation in DEGRADATIONS:
        print(f"  ! {degradation['code']}")
        print(f"    失去：{degradation['lost']}")
        print(f"    保留：{degradation['kept']}")
        print(f"    恢复于：{degradation['restoredBy']}")
    return EXIT_OK


def main(argv=None):
    """
    解析参数并分派。
    @param argv 命令行参数；缺省取 `sys.argv[1:]`
    @returns 退出码
    """
    parser = _Parser(prog='kvvi-admin', description='KVVI-Agent 运维入口')
    sub = parser.add_subparsers(dest='command')

    check = sub.add_parser('preflight', help='只读的环境检查')
    check.add_argument('--json', action='store_true', help='以 JSON 输出（供脚本与 Agent 消费）')
    check.add_argument('--config', default=None, help='安装配置文件的路径')

    for name in ('install', 'start', 'stop'):
        done = sub.add_parser(name, help='首次安装' if name == 'install' else
                              ('起进程' if name == 'start' else '停进程'))
        done.add_argument('--plan', action='store_true', help='只打印计划，不改动任何东西')
        done.add_argument('--apply', action='store_true', help='执行')
        done.add_argument('--yes', action='store_true', help='非交互环境下的确认')
        done.add_argument('--config', default=None)

    status = sub.add_parser('status', help='报告两个进程的状态与已知降级')
    status.add_argument('--json', action='store_true')
    status.add_argument('--config', default=None)

    launchd = sub.add_parser('launchd', help='打印 LaunchAgent plist（不自安装）')
    launchd.add_argument('--config', default=None)
    launchd.add_argument('--platform-port', type=int, default=7400)
    launchd.add_argument('--runtime-port', type=int, default=7401)

    for name in PLANNED:
        planned = sub.add_parser(name, help='（尚未实现）')
        planned.add_argument('--plan', action='store_true')
        planned.add_argument('--apply', action='store_true')
        planned.add_argument('--yes', action='store_true')
        planned.add_argument('--config', default=None)

    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return EXIT_USAGE
    if args.command == 'preflight':
        return cmd_preflight(args)
    if args.command == 'install':
        return cmd_install(args)
    if args.command == 'start':
        return cmd_start(args)
    if args.command == 'stop':
        return cmd_stop(args)
    if args.command == 'status':
        return cmd_status(args)
    if args.command == 'launchd':
        config = load_config(args.config)
        print(launchd_plist(home=Path(config['home']), release_root=HERE,
                            platform_port=args.platform_port,
                            runtime_port=args.runtime_port), end='')
        return EXIT_OK
    if args.command in PLANNED:
        print(f'✗ `{args.command}` 尚未实现（阶段十一后续任务接上）。')
        print(f"  当前可用的子命令：{', '.join(IMPLEMENTED)}")
        return EXIT_USAGE
    parser.print_help()
    return EXIT_USAGE


if __name__ == '__main__':
    sys.exit(main())
