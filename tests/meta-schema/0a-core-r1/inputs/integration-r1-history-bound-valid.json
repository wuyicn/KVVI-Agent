{
  "contract_version": "business-schema/v1",
  "base_version": 1,
  "spec": {
    "schema_code": "general_item",
    "field_type_registry_ref": {
      "scope_type": "PLATFORM_CONTROL",
      "scope_id": "kvvi-platform",
      "app_id": null,
      "module_id": null,
      "asset_type": "FIELD_TYPE_REGISTRY",
      "asset_id": "business-field-types-core",
      "version": 1,
      "digest": "sha256:a36716610e06b202ea165484cd58fef645905408aac7534ebdb47791c17649d2"
    },
    "name": "通用事项登记",
    "description": "用于验证 BusinessSchema v1 和通用 CRUD 运行时",
    "record_number": {
      "field_code": "record_no",
      "label": "事项编号",
      "sequence_policy_ref": {
        "scope_type": "TENANT",
        "scope_id": "11111111-1111-4111-8111-111111111111",
        "app_id": "22222222-2222-4222-8222-222222222222",
        "module_id": "33333333-3333-4333-8333-333333333333",
        "asset_type": "SEQUENCE_POLICY",
        "asset_id": "general_item_no",
        "version": 1,
        "digest": "sha256:70a87c366be01435b75dfd7bc35444ea7e232022ddfb0cecf3e7042853bf81bc"
      }
    },
    "fields": [
      {
        "field_code": "title",
        "label": "标题",
        "description": "事项的简短名称",
        "type": "short_text",
        "required": true,
        "nullable": false,
        "write_policy": "MUTABLE",
        "constraints": {
          "min_length": 1,
          "max_length": 120,
          "trim": true
        },
        "query": {
          "searchable": true,
          "filterable": true,
          "sortable": true
        },
        "deprecated": false
      },
      {
        "field_code": "category",
        "label": "分类",
        "type": "single_select",
        "required": true,
        "nullable": false,
        "write_policy": "MUTABLE",
        "type_config": {
          "options": [
            {
              "code": "general",
              "label": "一般",
              "order": 1,
              "enabled": true
            },
            {
              "code": "urgent",
              "label": "紧急",
              "order": 2,
              "enabled": true
            }
          ]
        },
        "query": {
          "searchable": true,
          "filterable": true,
          "sortable": true
        },
        "deprecated": false
      },
      {
        "field_code": "quantity",
        "label": "数量",
        "type": "integer",
        "required": true,
        "nullable": false,
        "default": 1,
        "write_policy": "MUTABLE",
        "constraints": {
          "minimum": 1,
          "maximum": 1000000
        },
        "query": {
          "searchable": false,
          "filterable": true,
          "sortable": true
        },
        "deprecated": false
      },
      {
        "field_code": "amount",
        "label": "预计金额",
        "type": "money",
        "required": false,
        "nullable": true,
        "write_policy": "MUTABLE",
        "type_config": {
          "currency_mode": "FIXED",
          "currency": "CNY"
        },
        "constraints": {
          "minimum": "0.00"
        },
        "query": {
          "searchable": false,
          "filterable": true,
          "sortable": true
        },
        "deprecated": false
      },
      {
        "field_code": "due_date",
        "label": "截止日期",
        "type": "date",
        "required": false,
        "nullable": true,
        "write_policy": "MUTABLE",
        "query": {
          "searchable": false,
          "filterable": true,
          "sortable": true
        },
        "deprecated": false
      },
      {
        "field_code": "notes",
        "label": "说明",
        "type": "long_text",
        "required": false,
        "nullable": true,
        "write_policy": "MUTABLE",
        "constraints": {
          "max_length": 5000
        },
        "query": {
          "searchable": true,
          "filterable": false,
          "sortable": false
        },
        "deprecated": false
      }
    ],
    "indexes": [
      {
        "index_code": "idx_category_due_date",
        "kind": "NORMAL",
        "fields": [
          "category",
          "due_date"
        ]
      }
    ],
    "record_rules": [
      {
        "rule_code": "large_quantity_requires_notes",
        "when": {
          "field": "quantity",
          "operator": "gt",
          "value": 100
        },
        "assert": {
          "field": "notes",
          "operator": "not_empty"
        },
        "message": "数量超过 100 时必须填写说明"
      }
    ],
    "layout": {
      "sections": [
        {
          "section_code": "basic",
          "title": "基本信息",
          "description": "填写事项的基础内容",
          "columns": 2,
          "items": [
            {
              "kind": "field",
              "field_code": "title",
              "col_span": 2
            },
            {
              "kind": "field",
              "field_code": "category",
              "col_span": 1
            },
            {
              "kind": "field",
              "field_code": "quantity",
              "col_span": 1
            },
            {
              "kind": "field",
              "field_code": "amount",
              "col_span": 1
            },
            {
              "kind": "field",
              "field_code": "due_date",
              "col_span": 1
            },
            {
              "kind": "field",
              "field_code": "notes",
              "col_span": 2
            }
          ]
        }
      ]
    }
  }
}
